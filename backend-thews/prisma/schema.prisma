generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // 1-to-1 User Profile
  profile       Profiles?

  // Relations
  refreshTokens RefreshToken[]
  workouts      Workouts[]
  routines      Routines[]
  runActivities RunActivities[]
  customExercises Exercises[]
  aiCoachLogs   AICoachLog[]

  @@map("users")
}

model Profiles {
  id              String         @id @default(uuid())
  userId          String         @unique
  username        String?        @unique
  displayName     String
  avatarUrl       String?
  bio             String?
  gender          String?        // 'male' | 'female' | 'other'
  birthDate       DateTime?
  heightCm        Float?
  weightKg        Float?
  unitPreference  String         @default("kg") // 'kg' | 'lbs'
  distanceUnit    String         @default("km") // 'km' | 'miles'
  fitnessGoal     String?        // 'hypertrophy' | 'strength' | 'endurance' | 'fat_loss'
  experienceLevel String?        // 'beginner' | 'intermediate' | 'advanced'
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts        Workouts[]
  routines        Routines[]
  runActivities   RunActivities[]
  customExercises Exercises[]
  aiCoachLogs     AICoachLog[]

  @@index([userId])
  @@map("profiles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Exercises {
  id                    Int       @id @default(autoincrement())
  userId                String?   // null if system default exercise, populated if custom
  profileId             String?   // profile linked identifier for multi-profile/user scoping
  name                  String    @db.VarChar(100)
  muscleGroup           String
  secondaryMuscleGroups String?
  isCustom              Boolean   @default(false)
  videoUrl              String?
  isDeleted             Boolean   @default(false)
  category              String?   @default("weight_reps")
  enabledMetrics        String?   @default("weight,reps")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user             User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile          Profiles?          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercises[]
  routineExercises RoutineExercises[]

  @@index([userId])
  @@index([profileId])
  @@index([muscleGroup])
  @@map("exercises")
}

model Workouts {
  id              Int       @id @default(autoincrement())
  userId          String
  profileId       String?
  date            DateTime  @default(now())
  notes           String?
  durationSeconds Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile          Profiles?          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercises[]
  runActivities    RunActivities[]

  @@index([userId, date])
  @@index([profileId, date])
  @@map("workouts")
}

model WorkoutExercises {
  id         Int @id @default(autoincrement())
  workoutId  Int
  exerciseId Int
  sortOrder  Int @default(0)

  workout    Workouts   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise   Exercises  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  setEntries SetEntries[]

  @@index([workoutId])
  @@index([exerciseId])
  @@map("workout_exercises")
}

model SetEntries {
  id                Int      @id @default(autoincrement())
  workoutExerciseId Int
  setNumber         Int
  weight            Float
  reps              Int
  unit              String   @default("kg")
  type              String   @default("normal") // 'warmup' | 'normal' | 'drop' | 'failure'
  distance          Float?
  distanceUnit      String?  @default("km")
  durationSeconds   Int?
  incline           Float?
  speed             Float?

  workoutExercise WorkoutExercises @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId])
  @@map("set_entries")
}

model Routines {
  id          Int       @id @default(autoincrement())
  userId      String
  profileId   String?
  name        String    @db.VarChar(100)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile          Profiles?          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  routineExercises RoutineExercises[]

  @@index([userId])
  @@index([profileId])
  @@map("routines")
}

model RoutineExercises {
  id                   Int    @id @default(autoincrement())
  routineId            Int
  exerciseId           Int
  targetSets           Int    @default(3)
  targetReps           Int    @default(10)
  targetWeight         Float  @default(0.0)
  targetDistance       Float?
  targetDurationSeconds Int?
  targetIncline        Float?
  sortOrder            Int    @default(0)

  routine  Routines  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercises @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([routineId])
  @@index([exerciseId])
  @@map("routine_exercises")
}

model RunActivities {
  id                   Int       @id @default(autoincrement())
  userId               String
  profileId            String?
  workoutId            Int?
  activityType         String    @default("run") // 'run' | 'walk' | 'cycle'
  startTime            DateTime  @default(now())
  distanceMeters       Float     @default(0.0)
  durationSeconds      Int       @default(0)
  avgPaceSecondsPerKm  Float     @default(0.0)
  elevationGainMeters  Float     @default(0.0)
  gpxData              String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profiles? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  workout Workouts? @relation(fields: [workoutId], references: [id], onDelete: SetNull)

  @@index([userId, startTime])
  @@index([profileId, startTime])
  @@index([workoutId])
  @@map("run_activities")
}

model AICoachLog {
  id        String    @id @default(uuid())
  userId    String
  profileId String?
  prompt    String    @db.Text
  response  String    @db.Text
  context   Json?
  createdAt DateTime  @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profiles? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([profileId, createdAt])
  @@map("ai_coach_logs")
}
