# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://thews_user:thews_password@localhost:5432/thews_db?schema=public"

# Security & JWT Tokens (Generate cryptographically secure secrets in production)
JWT_ACCESS_SECRET="thews_super_secret_access_jwt_key_development_only_12345"
JWT_REFRESH_SECRET="thews_super_secret_refresh_jwt_key_development_only_67890"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS="7"

# CORS Configuration (comma separated origins)
CORS_ORIGIN="*"

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# AI Coach Integration (Optional / Gemini or Anthropic)
GEMINI_API_KEY=""
